rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveMemberOf(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active == true
        && groupId in profile().groupIds;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'groupIds', 'active', 'locale', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.groupIds is list
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /instructors/{instructorId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string;
    }

    match /groups/{groupId} {
      allow read: if isAdmin() || isActiveMemberOf(groupId);
      allow write: if isAdmin();

      match /sessions/{sessionId} {
        allow read: if isAdmin() || isActiveMemberOf(groupId);
        allow write: if isAdmin();
      }

      match /recordings/{recordingId} {
        allow read: if isAdmin() || isActiveMemberOf(groupId);
        allow write: if isAdmin();
      }
    }
  }
}
